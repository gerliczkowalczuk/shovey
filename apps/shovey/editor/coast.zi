// Island's shores and banks. Sand shows a shore on every side that meets
// water and a meadow shows a bank on every side that leaves the meadow, so
// a painter only chooses sand, meadow or water and the coast follows. The
// choice depends on a cell's four neighbours alone; the shipped islands use
// exactly these tiles (see assets/shovey-island/art.json).

// Sand tiles: plain sand and its shores (10 is a flower bed, not sand).
CoastSand :: (terrain: s32) -> bool { return terrain >= 1 && terrain <= 12 && terrain != 10 }

// Raised meadow tiles: plain meadow and its banks.
CoastMeadow :: (terrain: s32) -> bool { return terrain >= 13 && terrain <= 23 }

// What a shore faces: open water and what floats on it, and the board's edge.
CoastWater :: (terrain: s32) -> bool {
    return terrain < 0 || terrain == 0 || terrain == 29 || terrain == 38 || terrain == 40 ||
    terrain == 42 || terrain == 43
}

// What continues a meadow: meadow, and meadow with a flower ring.
CoastMeadowLike :: (terrain: s32) -> bool { return CoastMeadow(terrain) || terrain == 47 || terrain == 48 }

// The terrain beside at in a direction (left, up, right, down), or -1 off the board.
CoastNeighbor :: (terrain: []u8, at: s32, direction: s32) -> s32 {
    x := at % 20; y := at / 20
    if direction == 0 { return ifx x > 0 then cast(s32)terrain[at - 1] else -1 }
    if direction == 1 { return ifx y > 0 then cast(s32)terrain[at - 20] else -1 }
    if direction == 2 { return ifx x < 19 then cast(s32)terrain[at + 1] else -1 }
    return ifx y < 11 then cast(s32)terrain[at + 20] else -1
}

// The sides of at that meet water (sand) or leave the meadow (meadow):
// 1 left, 2 up, 4 right, 8 down.
CoastSides :: (terrain: []u8, at: s32, meadow: bool) -> s32 {
    sides: s32 = 0
    for direction: cast(s32)0..3 {
        beside := CoastNeighbor(terrain, at, direction)
        open := ifx meadow then !CoastMeadowLike(beside) else CoastWater(beside)
        if open { sides = sides | (1 << direction) }
    }
    return sides
}

// The sand tile for its open sides: corners round, two opposite sides make
// a narrow bar. A sand cell with three or four open sides has no tile of its
// own; it takes the one the shipped islands use for it.
CoastSandTile :: (sides: s32) -> s32 {
    tiles: [16]s32 = .[1, 12, 8, 2, 9, 7, 3, 2, 11, 5, 6, 6, 4, 5, 6, 6]
    return tiles[sides & 15]
}

CoastMeadowTile :: (sides: s32) -> s32 {
    tiles: [16]s32 = .[13, 23, 20, 14, 21, 19, 15, 19, 22, 17, 18, 18, 16, 19, 18, 18]
    return tiles[sides & 15]
}

// The tile cell at should show: its sand or meadow variant, or its own kind
// when it is neither.
CoastTile :: (terrain: []u8, at: s32) -> s32 {
    kind := cast(s32)terrain[at]
    if CoastSand(kind) { return CoastSandTile(CoastSides(terrain, at, false)) }
    if CoastMeadow(kind) { return CoastMeadowTile(CoastSides(terrain, at, true)) }
    return kind
}

// Re-tiles at and its four neighbours after at changed.
CoastAround :: (terrain: []u8, at: s32) {
    cells: [5]s32 = .[at, ifx at % 20 > 0 then at - 1 else -1, ifx at >= 20 then at - 20 else -1,
    ifx at % 20 < 19 then at + 1 else -1, ifx at < 220 then at + 20 else -1]
    for cell: cells {
        if cell >= 0 { terrain[cell] = cast(u8)CoastTile(terrain, cell) }
    }
}

// Re-tiles a whole island.
CoastAll :: (terrain: []u8) {
    plain: [240]u8
    for at: cast(s32)0..239 { plain[at] = terrain[at] }
    for at: cast(s32)0..239 { terrain[at] = cast(u8)CoastTile(plain[:], at) }
}
