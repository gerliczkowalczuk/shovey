// The independent Island node draws its two layers with Image.
// It shares no live state or records with the Classic leaf.
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/text_props"
#import "kryon/text_align"
#import "kryon/text_widget"
#import "kryon/button_props"
#import "kryon/button_widget"
#import "kryon/control_props"
#import "kryon/image_props"
#import "kryon/image_widget"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/scroll_props"
#import "kryon/scroll_widget"
#import "kryon/tree"
#import "std/number_text"
#import "std/c_string"
#import "std/text_buffer"
#import "translations"
#import "apps/node_types"
#import "kryon/tile_map"
#import "kryon/widget_palette"
#import, file "../orientation.zi";
#import, file "island_engine.zi";
#import, file "island_board.zi";
#import, file "progress.zi";
#import, file "../island_levels.zi";
#import, file "../controls.zi";
#import, file "../shovey_theme.zi";
host_api :: #system_library "host_api";
ReadAppUiHost :: () -> AppUiFrame #foreign host_api;
AppRecordHost :: (name: string) -> string #foreign host_api;
SaveAppRecordHost :: (name: string, text: string) -> bool #foreign host_api;
AppKeyHost :: () -> s32 #foreign host_api;
// One of the game's own packed sounds; a host without audio answers false.
AppSoundHost :: (path: string) -> bool #foreign host_api;

island_frame: AppUiFrame;
island_game: IslandGame;
island_progress: IslandProgress;
island_loaded: bool;
island_selector: bool;
island_help: bool;
island_scroll: s32;
island_help_scroll: s32;
// Hidden once a keyboard is used; shown again when the island is touched.
island_save_failed: bool;
island_language: string;
island_previews: [176][96]u8;
island_preview_landscape: bool;
island_names: [ISLAND_PICTURES]string;
island_heading: [512]u8;
island_instructions: [16384]u8;

ISLAND_LOCK :: "S1.8rr:M6 10H18V21H6ZM8 10V7A4 4 0 0 1 16 7V10M12 14V17"
ISLAND_CHECK :: "S2rr:M5 12L10 17L20 6"
ISLAND_PLAY :: "F:M8 5L19 12L8 19Z"

IslandText :: (key: string) -> string {
    text := GameLocaleText(island_language, key)
    return ifx text != "" then text else key
}

IslandInstructions :: () -> string {
    keys: [16]string = .["island_help_1", "island_help_2", "island_help_3", "island_help_4",
    "island_help_5", "island_help_6", "island_help_7", "island_help_8", "island_help_9", "island_help_10",
    "island_help_11", "island_help_12", "island_help_13", "island_help_14", "island_help_15", "island_help_16"]
    bytes: Vec(u8)
    for at: cast(s32)0..15 {
        if at > 0 && island_language != "ja" && island_language != "zh" { BuilderPrint(*bytes, " ") }
        BuilderPrint(*bytes, "%", IslandText(keys[at]))
    }
    unused CopyCString(TextView(VecSlice(bytes, 0, bytes.count)), island_instructions[:])
    VecFree(bytes)
    return TextUntilNul(island_instructions[:])
}

IslandFill :: (key: u64, bounds: Rectangle, color: Color, radius: float32 = 0.0) {
    unused Box(island_frame.session, BoxProps.{.key = key, .bounds = bounds, .fill = color, .radius = radius})
}

IslandCaption :: (key: u64, bounds: Rectangle, text: string, font: s32 = 16, center: bool = false) {
    Text(island_frame.session, TextProps.{.key = key, .bounds = bounds, .text = text, .font = font,
            .wrap = TextWrap.TextWrapAuto, .align = ifx center then TextAlign.TextAlignCenter else TextAlign.TextAlignStart,
            .vertical_align = TextAlign.TextAlignCenter})
}

// A button; with an icon it shows only the icon and keeps label for
// screen readers and tooltips.
IslandControl :: (id: s32, bounds: Rectangle, label: string, disabled: bool = false, detail: string = "",
    icon: string = "") -> bool {
    return Button(island_frame.session, ButtonProps.{.key = cast(u64)id, .id = id, .bounds = bounds,
            .label = label, .detail = detail, .disabled = disabled, .fit_content = true,
            .icon_shape = icon, .icon_only = icon != "",
            .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0
}

IslandSpritePaths :: (landscape: bool) {
    if island_preview_landscape == landscape && island_previews[1][0] != 0 { return }
    for number: cast(s32)1..175 {
        bytes: Vec(u8)
        if landscape { BuilderPrint(*bytes, "assets/shovey-island/levels-landscape/%.png", number) }
        else { BuilderPrint(*bytes, "assets/shovey-island/levels/%.png", number) }
        unused CopyCString(TextView(VecSlice(bytes, 0, bytes.count)), island_previews[number][:])
        VecFree(bytes)
    }
    island_preview_landscape = landscape
}

IslandTileText :: (kind: s32) -> string {
    if kind == 56 { return "Shovey" }
    if kind == 75 { return IslandText("island_home") }
    if kind == 57 { return IslandText("island_crate") }
    if kind == 60 { return IslandText("island_key") }
    if kind == 64 { return IslandText("island_seed") }
    if kind == 66 || kind == 73 || kind == 74 { return IslandText("island_crab") }
    if kind == 80 { return IslandText("island_ammo") }
    if kind == 81 || kind == 94 || kind == 95 { return IslandText("island_pearl") }
    if kind == 82 || kind == 58 || kind == 90 { return IslandText("island_coin") }
    if kind == 70 || kind == 71 { return IslandText("island_coconut") }
    if kind == 37 || kind == 39 { return IslandText("island_portal") }
    if kind == 122 || kind == 123 || kind == 124 { return IslandText("island_string") }
    return IslandText(ifx kind >= 51 then "island_object" else "island_terrain")
}

// Each picture number's description, for the island's pictures.
IslandNames :: () {
    for number: cast(s32)0..ISLAND_TILES - 1 { island_names[number] = IslandTileText(number) }
    for number: cast(s32)ISLAND_TILES..ISLAND_PICTURES - 1 { island_names[number] = "Shovey" }
}

IslandImage :: (key: u64, path: string, bounds: Rectangle, label: string) {
    Image(island_frame.session, ImageProps.{.key = key, .asset_path = path, .bounds = bounds,
            .alt_text = label, .fit = ImageFit.ImageFitContain, .smooth = true})
}

IslandHeading :: () -> string {
    bytes: Vec(u8)
    BuilderPrint(*bytes, "% % / %", IslandText("island_level"), island_game.level, IslandLevelCount())
    unused CopyCString(TextView(VecSlice(bytes, 0, bytes.count)), island_heading[:])
    VecFree(bytes)
    return TextUntilNul(island_heading[:])
}

// The solved-level count last reported to the leaderboard.
island_reported_levels: s32 = -1;

IslandRemember :: (advance: bool = true) {
    IslandRecordWin(*island_progress, *island_game)
    if advance { unused IslandContinue(*island_progress, *island_game) }
    island_save_failed = !SaveAppRecordHost("campaign", IslandCampaignSave(*island_progress, *island_game))
    ReportSolvedLevels(island_progress.completed[:], *island_reported_levels)
}

IslandOpenLevel :: (level: s32) {
    if !IslandSelectLevel(*island_progress, *island_game, level) { return }
    island_selector = false; island_help = false
    IslandRemember(false)
}

// Moves and plays what the move did.
IslandAct :: (direction: s32) -> bool {
    before := island_game
    changed := IslandMove(*island_game, direction)
    event := ISLAND_EVENT_NONE
    if changed { event = IslandEvent(*before, *island_game) }
    if event != ISLAND_EVENT_NONE && !SoundMuted() {
        sounds: [9]string = .["", "assets/shovey-island/sounds/push.wav", "assets/shovey-island/sounds/splash.wav",
        "assets/shovey-island/sounds/goal.wav", "assets/shovey-island/sounds/pickup.wav", "assets/shovey-island/sounds/gate.wav",
        "assets/shovey-island/sounds/teleport.wav", "assets/shovey-island/sounds/shot.wav", "assets/shovey-island/sounds/won.wav"]
        unused AppSoundHost(sounds[event])
    }
    return changed
}

IslandContinueGame :: () {
    unused IslandContinue(*island_progress, *island_game)
    island_selector = false; island_help = false
    IslandRemember(false)
}

IslandLevels :: (width: float32, top: float32, bottom: float32) {
    landscape := BoardLandscape(width, bottom - top)
    IslandSpritePaths(landscape)
    IslandCaption(81001, Rectangle.{16.0, top + 12.0, width - 156.0, 44.0}, IslandText("island_levels"), 24)
    if IslandControl(81002, Rectangle.{width - 132.0, top + 12.0, 116.0, 44.0}, IslandText("island_continue")) { IslandContinueGame(); return }
    columns: s32 = ifx width >= 440.0 then 2 else 1
    gap: float32 = 12.0
    cell_width := (width - 32.0 - gap * cast(float32)(columns - 1)) / cast(float32)columns
    preview_height := cell_width * ifx landscape then 3.0 / 5.0 else 5.0 / 3.0
    cell_height := preview_height + 64.0
    rows := (IslandLevelCount() + columns - 1) / columns
    scroll := Scroll(island_frame.session, ScrollProps.{.key = cast(u64)81003,
            .bounds = Rectangle.{16.0, top + 72.0, width - 32.0, bottom - top - 88.0},
            .content_height = cast(s32)(cast(float32)rows * (cell_height + gap)), .scroll_offset = island_scroll})
    island_scroll = scroll.scroll_offset
    selected: s32
    if scroll.opened {
        for number: cast(s32)1..IslandLevelCount() {
            index := number - 1
            cell := Rectangle.{scroll.content.x + cast(float32)(index % columns) * (cell_width + gap),
                scroll.content.y + cast(float32)(index / columns) * (cell_height + gap), cell_width, cell_height}
            if cell.y + cell.height < scroll.viewport.y || cell.y > scroll.viewport.y + scroll.viewport.height { continue }
            unlocked := IslandLevelUnlocked(*island_progress, number)
            complete := island_progress.completed[index]
            key := cast(u64)(90000 + number * 5000)
            if unlocked {
                IslandImage(key + cast(u64)1, TextUntilNul(island_previews[number][:]),
                    Rectangle.{cell.x + 6.0, cell.y + 6.0, cell.width - 12.0,
                        (cell.width - 12.0) * ifx landscape then 3.0 / 5.0 else 5.0 / 3.0}, IslandLevelName(number))
            }
            digits: [24]u8
            label := FormatInteger(cast(s64)number, digits[:])
            if Button(island_frame.session, ButtonProps.{.key = key + cast(u64)4000, .id = 82000 + number,
                    .bounds = cell, .label = label, .detail = IslandLevelName(number), .invisible = true, .disabled = !unlocked}) != 0 { selected = number }
            name_y := cell.y + cell.height - 48.0
            IslandCaption(key + cast(u64)4001, Rectangle.{cell.x + 8.0, name_y, cell.width - 48.0, 40.0}, label, 18)
            IslandCaption(key + cast(u64)4002, Rectangle.{cell.x + 40.0, name_y, cell.width - 80.0, 40.0}, IslandLevelName(number), 14)
            unused Button(island_frame.session, ButtonProps.{.key = key + cast(u64)4003,
                    .bounds = Rectangle.{cell.x + cell.width - 36.0, name_y + 6.0, 28.0, 28.0},
                    .label = IslandText(ifx !unlocked then "island_locked" else ifx complete then "island_completed" else "island_available"),
                    .icon_shape = ifx !unlocked then ISLAND_LOCK else ifx complete then ISLAND_CHECK else ISLAND_PLAY,
                    .icon_only = true, .disabled = true, .fit_content = true, .emphasis = ButtonEmphasis.ButtonEmphasisGhost})
        }
        unused End(island_frame.session)
    }
    if selected > 0 { IslandOpenLevel(selected) }
}

IslandInventory :: (bounds: Rectangle) {
    values: [6]s32 = .[island_game.keys, island_game.seeds, island_game.crabs, island_game.ammunition, island_game.coins, island_game.pearls]
    sprites: [6]s32 = .[60, 64, 66, 80, 82, 81]
    cell := bounds.width / 6.0
    for at: cast(s32)0..5 {
        if values[at] <= 0 { continue }
        x := bounds.x + cast(float32)at * cell
        IslandImage(cast(u64)(84000 + at * 2), IslandPictureFile(sprites[at]), Rectangle.{x, bounds.y, 24.0, 24.0}, IslandTileText(sprites[at]))
        digits: [24]u8
        IslandCaption(cast(u64)(84001 + at * 2), Rectangle.{x + 26.0, bounds.y, cell - 26.0, 24.0}, FormatInteger(cast(s64)values[at], digits[:]), 14)
    }
}

IslandFrame :: (language: string) {
    island_frame = ReadAppUiHost()
    island_language = language
    if !island_loaded {
        if !IslandCampaignRestore(*island_progress, *island_game, AppRecordHost("campaign")) {
            unused IslandLoad(*island_game, 1)
            island_progress = IslandProgressNew()
        }
        if IslandOpenLatest(*island_progress, *island_game) { IslandRemember(false) }
        ReportSolvedLevels(island_progress.completed[:], *island_reported_levels)
        island_loaded = true
    }
    width := cast(float32)island_frame.width
    top := cast(float32)island_frame.top
    bottom := cast(float32)(island_frame.height - island_frame.bottom)
    ShoveyDress(island_frame.session, width, top, bottom)

    if island_selector { IslandLevels(width, top, bottom); return }
    key := AppKeyHost()
    if key == 72 { island_help = !island_help }
    if key == 256 { island_help = false }
    // Return sits at the edge, then the island's own navigation and status.
    if IslandControl(80018, Rectangle.{8.0, top + 4.0, 44.0, 44.0}, IslandText("island_select_game"), false, "", ICON_GAMES) {
        LeaveForGameSelection()
        return
    }
    if IslandControl(80005, Rectangle.{56.0, top + 4.0, 44.0, 44.0}, IslandText("island_levels"), false, "", ICON_LEVELS) {
        island_selector = true
        return
    }
    IslandCaption(80004, Rectangle.{108.0, top + 4.0, width - 220.0, 44.0}, IslandHeading(), 14, true)
    if IslandControl(80015, Rectangle.{width - 156.0, top + 4.0, 44.0, 44.0}, IslandText("island_restart"), false, "", ICON_RESTART) {
        IslandOpenLevel(island_game.level)
    }
    if IslandControl(80006, Rectangle.{width - 104.0, top + 4.0, 44.0, 44.0}, IslandText("island_help"), false, "",
            ifx island_help then ICON_CLOSE else ICON_HELP) {
        island_help = !island_help
    }
    if IslandControl(80019, Rectangle.{width - 52.0, top + 4.0, 44.0, 44.0},
            IslandText(ifx SoundMuted() then "island_unmute" else "island_mute"), false, "",
            ifx SoundMuted() then ICON_SOUND_OFF else ICON_SOUND_ON) {
        SoundSetMuted(!SoundMuted())
    }
    if island_help {
        scroll := Scroll(island_frame.session, ScrollProps.{.key = cast(u64)80008,
                .bounds = Rectangle.{16.0, top + 56.0, width - 32.0, bottom - top - 64.0},
                .content_height = 1600, .scroll_offset = island_help_scroll})
        island_help_scroll = scroll.scroll_offset
        if scroll.opened {
            Text(island_frame.session, TextProps.{.key = cast(u64)80009,
                    .bounds = Rectangle.{scroll.content.x, scroll.content.y, scroll.content.width - 12.0, 1500.0},
                    .text = IslandInstructions(), .font = 16, .wrap = TextWrap.TextWrapAuto})
            unused End(island_frame.session)
        }
        return
    }
    // The island fills the space under the bar, in portrait or landscape.
    status_y := top + 52.0
    area := Rectangle.{8.0, status_y + 52.0, width - 16.0, bottom - status_y - 60.0}
    landscape := BoardLandscape(area.width, area.height)
    changed: bool
    before := island_game.direction
    keyed: s32 = -1
    if key == 263 || key == 65 { keyed = 0 }
    if key == 265 || key == 87 { keyed = 1 }
    if key == 262 || key == 68 { keyed = 2 }
    if key == 264 || key == 83 { keyed = 3 }
    // A keyboard player does not need the on-screen stick until they touch.
    if keyed >= 0 { changed = IslandAct(BoardEngineDirection(keyed, landscape)) }
    if key == 82 { IslandOpenLevel(island_game.level) }
    if changed { IslandRemember(); changed = false; before = island_game.direction }
    IslandNames()
    grid := IslandBoard(island_frame.session, *island_game, area, cast(u64)85000, island_names[:], landscape)
    status := IslandLevelName(island_game.level)
    status_icon := ""
    if island_game.won {
        status = IslandText("island_finale")
        status_icon = "S2rr:M5 12L10 17L19 7"
    } else if IslandRemaining(*island_game) == 0 {
        status = IslandText("island_ready")
        status_icon = "S2rr:M6 10H18V21H6ZM8 10V6L10 4H14L16 6V10"
    }
    if status_icon != "" {
        unused Button(island_frame.session, ButtonProps.{.key = cast(u64)80021, .id = 80021,
                .bounds = Rectangle.{width / 2.0 - 20.0, status_y - 8.0, 40.0, 40.0},
                .label = status, .icon_shape = status_icon, .icon_only = true,
                .disabled = true, .fit_content = true, .emphasis = ButtonEmphasis.ButtonEmphasisGhost})
    } else {
        IslandCaption(80010, Rectangle.{16.0, status_y, width - 32.0, 24.0}, status, 15, true)
    }
    IslandInventory(Rectangle.{16.0, status_y + 24.0, width - 32.0, 24.0})
    if island_save_failed { IslandCaption(80016, Rectangle.{16.0, bottom - 28.0, width - 32.0, 24.0}, IslandText("island_save_failed"), 13, true) }
    disabled := island_game.won
    // Touch: swipe anywhere under the bar to step, or tap a cell to step
    // towards it; hold either to keep walking.
    play := Rectangle.{0.0, top + 52.0, width, bottom - top - 52.0}
    gesture := SwipeArea(island_frame.session, SwipeAreaProps.{.key = cast(u64)89000, .id = 89000, .bounds = play,
            .label = IslandText("island_controls"), .now = island_frame.now, .min_distance = grid.cell * 0.6, .repeat_seconds = 0.16, .disabled = disabled})
    step := BoardEngineDirection(gesture.swiped, landscape)
    if gesture.tapped || gesture.held {
        cell := TileMapCellAt(grid, gesture.x, gesture.y)
        cell = BoardLogicalIndex(cell, landscape)
        if cell >= 0 {
            step = TouchDirection(cast(float32)(cell % ISLAND_WIDTH - island_game.player % ISLAND_WIDTH),
                cast(float32)(cell / ISLAND_WIDTH - island_game.player / ISLAND_WIDTH), 1.0)
        }
    }
    if step >= 0 { changed = IslandAct(step) || changed }
    if changed || before != island_game.direction { IslandRemember() }
}
